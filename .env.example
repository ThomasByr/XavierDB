# .env — Docker Compose ONLY. The XavierDB app NEVER reads this file; these
# values are consumed by compose interpolation (compose `user:` and the
# resource ${VARS} in compose.prod.yaml / compose.example.yaml).
# Copy to `.env` and adjust.

UID=1000
GID=1000

# --- Resource tuning (prod stack: compose.prod.yaml / compose.example.yaml) -
# Only consumed by the PROD compose files (dev/pre use pinned literals).
# KEEP THESE CONSISTENT — compose cannot derive one from another:
#   - XAVIER_WT_CACHE_GB ≈ HALF of XAVIER_MONGO_MEM. The WiredTiger cache is
#     an internal mongod cap, but mongod ALSO needs the rest of the limit for
#     connections, sort buffers and filesystem cache — set the cache too high
#     and the cgroup OOM-kills mongod.
#   - memswap = memory limit + swap headroom.
# Defaults below target an 8 GB host (values shown are the compose defaults
# — setting them to the same numbers is a no-op, they are listed so the
# knobs are discoverable in one place).
XAVIER_MONGO_MEM=7g            # hard cgroup memory limit, MongoDB container
XAVIER_MONGO_MEMSWAP=8.5g      # RAM+swap cap (7g RAM + 1.5g swap)
XAVIER_MONGO_CPUS=3.0
XAVIER_WT_CACHE_GB=3.5         # --wiredTigerCacheSizeGB (≈ half of XAVIER_MONGO_MEM)
XAVIER_API_MEM=1g              # hard cgroup memory limit, API container
XAVIER_API_MEMSWAP=1.5g        # RAM+swap cap (1g RAM + 0.5g swap)
XAVIER_API_CPUS=1.0

# MongoDB data folder on the host (prod bind mount).
# VPS: an absolute path outside the repo, e.g. /home/<user>/data/xavier-mongo-db
# compose.example.yaml default: ./data/mongo (inside the checkout)
#XAVIER_MONGO_DATA=/home/you/data/xavier-mongo-db

# --- Optional: pin the compose file pair for THIS host -----------------------
# Uncomment and set per host so bare `docker compose <cmd>` (no -f) uses the
# right stack (without it, bare compose loads only the base compose.base.yaml —
#   dev machine: COMPOSE_FILE=compose.yaml:compose.dev.yaml
#   pre-prod:    COMPOSE_FILE=compose.yaml:compose.pre.yaml
#   VPS:         COMPOSE_FILE=compose.yaml:compose.prod.yaml
# Explicit `-f` flags (xdb-compose.sh / deploy.sh always pass them) take
# precedence over this, so the script always runs the pair it prints.
# NEVER set this if you deployed from compose.example.yaml — your
# in that setup compose.yaml is standalone; merging a repo overlay on top silently
# changes limits and storage.
# Windows note: the separator is `:` on Linux/macOS, `;` on Windows.
#COMPOSE_FILE=compose.yaml:compose.prod.yaml
