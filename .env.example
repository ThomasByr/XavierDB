# XavierDB environment configuration (read at startup; edit + restart to apply)
# Copy this file to `.env` next to the executable / working directory.

# --- TLS (optional) ---
# Point at a PEM certificate and private key to serve HTTPS.
# Leave both empty for plain HTTP. Certificates are hot-reloaded on change.
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- network ---
HOST=127.0.0.1
PORT=8000
MONGODB_URI=mongodb://localhost:27017

# --- runtime ---
# Number of Tokio worker threads (default 4).
MAX_WORKERS=4
# Max documents per insert batch (POST /q with array `data`). Batches larger
# than this are rejected with 400 before reaching MongoDB. Default 1000;
# must be >= 1 (MongoDB's own 100k write-batch limit still applies).
MAX_INSERT_BATCH=1000
# User and group IDs to run the container as (default 1000:1000).
# This is only used when running the rust API docker container, not when running the binary directly.
UID=1000
GID=1000

# --- admin dashboard ---
# Username for the dashboard login.
USERNAME=admin
# Argon2id PHC hash of the dashboard password.
# IMPORTANT: the value contains '$' signs, so it MUST be single-quoted:
#   PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# If you leave this empty, the server generates a strong 64-char password,
# hashes it, writes the hash here (quoted) and prints the password to the
# terminal exactly once.
PASSWORD_HASH=''

# --- authentication (optional) ---
# Secret used to sign JWTs. If unset, a random secret is generated at startup
# and every existing token becomes invalid after a restart. Set a fixed value
# here to keep tokens valid across restarts.
# Any long random string works (it is hashed into the 256-bit signing key).
# Generate your own with:  openssl rand -base64 48
# IMPORTANT: never use a value that ships with the repo — a publicly known
# secret lets anyone forge tokens.
# JWT_SECRET=
