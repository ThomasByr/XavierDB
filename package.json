{
  "name": "xavierdb",
  "version": "2.1.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "esbuild src/assets/ts/app.ts --bundle --minify --outfile=src/assets/app.js --target=es2020",
    "watch": "esbuild src/assets/ts/app.ts --bundle --outfile=src/assets/app.js --watch",
    "cargo:dev": "npm run build && cargo run",
    "cargo:release": "npm run build && cargo run --release",
    "release": "release-it",
    "format": "cargo fmt --all && cargo fmt --all --manifest-path examples/Cargo.toml && npm run format:ts",
    "format:ts": "npx prettier --write src/assets/ts/**/*.ts",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings && cargo clippy --all-targets --all-features --manifest-path examples/Cargo.toml -D warnings && npm run lint:ts",
    "lint:ts": "npx prettier --check src/assets/ts/**/*.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@release-it/bumper": "^8.0.0",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.13.1",
    "jsdom": "^24.1.3",
    "release-it": "^21.0.2"
  }
}
